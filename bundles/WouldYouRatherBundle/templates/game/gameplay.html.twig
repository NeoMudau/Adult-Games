{% extends 'base.html.twig' %}

{% block title %}Would You Rather - Gameplay{% endblock %}

{% block body %}
<div style="max-width: 800px; margin: 50px auto; text-align: center;">

    <h1>Would You Rather 🎮</h1>

    <div id="game-container" data-question-id="{{ question.id }}">

        <h2 id="question">
            {{ question.question }}
        </h2>

        <div style="margin-top: 30px;">

            <button
                type="button"
                id="option-a"
                onclick="chooseOption()"
            >
                {{ question.optionA }}
            </button>

            <span style="margin: 0 20px;">
                OR
            </span>

            <button
                type="button"
                id="option-b"
                onclick="chooseOption()"
            >
                {{ question.optionB }}
            </button>

        </div>

    </div>

</div>

<script>
let seenQuestionIds = [
    {{ question.id }}
];

async function chooseOption() {
    const params = new URLSearchParams();

    seenQuestionIds.forEach(function(id) {
        params.append('exclude[]', id);
    });

    {% for category in categories %}
        params.append('categories[]', '{{ category|e('js') }}');
    {% endfor %}

    {% for tag in tags %}
        params.append('tags[]', '{{ tag|e('js') }}');
    {% endfor %}

    let response = await fetch(
        '{{ path('would_you_rather_random_question') }}' +
        '?' +
        params.toString()
    );

    // All matching questions have been seen
    if (response.status === 404) {

        // Start a new round
        const lastQuestionId =
            document.getElementById('game-container').dataset.questionId;

        seenQuestionIds = [
            parseInt(lastQuestionId)
        ];

        const resetParams = new URLSearchParams();

        {% for category in categories %}
            resetParams.append(
                'categories[]',
                '{{ category|e('js') }}'
            );
        {% endfor %}

        {% for tag in tags %}
            resetParams.append(
                'tags[]',
                '{{ tag|e('js') }}'
            );
        {% endfor %}

        response = await fetch(
            '{{ path('would_you_rather_random_question') }}' +
            '?' +
            resetParams.toString()
        );
    }

    if (!response.ok) {
        console.error('Could not load another question.');
        return;
    }

    const question = await response.json();

    seenQuestionIds.push(question.id);

    document.getElementById('question').textContent =
        question.question;

    document.getElementById('option-a').textContent =
        question.optionA;

    document.getElementById('option-b').textContent =
        question.optionB;

    document
        .getElementById('game-container')
        .dataset.questionId = question.id;
}
</script>
{% endblock %}