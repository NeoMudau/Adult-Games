{% extends 'base.html.twig' %}

{% block title %}Would You Rather{% endblock %}

{% block body %}
<div style="max-width: 800px; margin: 50px auto;">

    <h1 style="text-align: center;">
        Would You Rather 🎮
    </h1>

    <form
        method="get"
        action="{{ path('would_you_rather_gameplay') }}"
    >

        <h2>Choose Categories</h2>

        {% for label, value in categories %}
            <div>
                <label>
                    <input
                        type="checkbox"
                        name="categories[]"
                        value="{{ value }}"
                    >

                    {{ label }}
                </label>
            </div>
        {% endfor %}


        <h2 style="margin-top: 30px;">
            Choose Tags / Vibe
        </h2>

        {% for label, value in tags %}
            <div>
                <label>
                    <input
                        type="checkbox"
                        name="tags[]"
                        value="{{ value }}"
                    >

                    {{ label }}
                </label>
            </div>
        {% endfor %}


        <div style="margin-top: 30px;">
            <button type="submit">
                Start Game
            </button>
        </div>

    </form>

</div>
{% endblock %}