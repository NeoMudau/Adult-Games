{% extends 'base.html.twig' %}

{% block title %}Hello HomeController!{% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

<div class="example-wrapper">
    <h1Welcome! ✅</h1>

    This is where everyone will see the games currently available, for them to select and play
    <ul>
        <li>Games will be in some sort of cards, title image and description</li>
        <li>after selecting a game you login or play as guest</li>
    </ul>
    <a href="{{ path('app_login') }}">Login here</a>
    <a href="{{ path('app_register') }}">Register here</a> <br>
    <a href="{{ path('app_games') }}">Play as Guest</a>
</div>
{% endblock %}
