{% extends 'base.html.twig' %}

{% block title %}All Games{% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

<div class="example-wrapper">
    <h1>All Games</h1>

    Select a game below to begin playing
    <ul style="list-style-type: none">
        <li>
            <a href="{{ path('app_wouldYouRather') }}"> 
                <div style = "width: 40%; height: 40%; background-color: rgba(231, 212, 70, 0.78); border-radius: 30px; padding: 10px">
                    <h2>Would you Rather</h2>
                    <p>Play Would you Rather</p>
                </div>
            </a>
        </li>
        <br>
        <li>
            <a href="{{ path('app_truthOrDare') }}">
                <div style = "width: 40%; height: 40%; background-color: rgba(70, 161, 231, 0.78); border-radius: 30px; padding: 10px">
                    <h2>Truth or Dare</h2>
                    <p>Play truth or dare</p>
                </div>
            </a>
        </li>
    </ul>
</div>
{% endblock %}
